      \u0E0A\u0E48\u0E27\u0E22\u0E14\u0E39\u0E43\u0E2B\u0E49\u0E17\u0E35\u0E19\u0E30"
    difficulty: 0
    customNoteSpeed: 0
    customNoteCount: 0
    passPercentage: 60
    npcName: "\u0E22\u0E32\u0E22\u0E17\u0E2D\u0E07"
    npcPortrait: {fileID: 1707211250, guid: 582d85b6ad204784ebb715458ac77e76, type: 3}
    npcGroupId: 
    inquiryDialogues:
    - "...(NPC \u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E44\u0E27\u0E49\u0E43\u0E08\u0E1E\u0E2D\u0E17\u0E35\u0E48\u0E08\u0E30\u0E1A\u0E2D\u0E01)"
    - "\u0E04\u0E27\u0E32\u0E21\u0E08\u0E23\u0E34\u0E07\u0E01\u0E47\u0E04\u0E37\u0E2D...
      (\u0E23\u0E30\u0E14\u0E31\u0E1A 1)"
    - "\u0E21\u0E35\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E17\u0E35\u0E48\u0E0B\u0E48\u0E2D\u0E19\u0E2D\u0E22\u0E39\u0E48...
      (\u0E23\u0E30\u0E14\u0E31\u0E1A 2)"
    - "\u0E02\u0E49\u0E32\u0E08\u0E30\u0E1A\u0E2D\u0E01\u0E04\u0E27\u0E32\u0E21\u0E25\u0E31\u0E1A\u0E2A\u0E38\u0E14\u0E17\u0E49\u0E32\u0E22...
      (\u0E23\u0E30\u0E14\u0E31\u0E1A 3)"
    greetingDialogue: 
    waitingDialogue: "\u0E02\u0E2D\u0E1A\u0E43\u0E08\u0E21\u0E32\u0E01\u0E19\u0E30\u0E2B\u0E21\u0E2D
      \u0E22\u0E32\u0E22\u0E44\u0E21\u0E48\u0E21\u0E35\u0E2D\u0E30\u0E44\u0E23\u0E15\u0E2D\u0E1A\u0E41\u0E17\u0E19\u0E21\u0E32\u0E01
      \u0E02\u0E2D\u0E43\u0E2B\u0E49\u0E1A\u0E38\u0E0D\u0E23\u0E31\u0E01\u0E29\u0E32\u0E19\u0E30\u0E08\u0E4A\u0E30"
    completeDialogue: "\u0E22\u0E2D\u0E14\u0E40\u0E22\u0E35\u0E48\u0E22\u0E21\u0E21\u0E32\u0E01!
      \u0E44\u0E14\u0E49\u0E02\u0E2D\u0E07\u0E04\u0E23\u0E1A\u0E16\u0E49\u0E27\u0E19\u0E41\u0E25\u0E49\u0E27
      \u0E02\u0E2D\u0E1A\u0E1E\u0E23\u0E30\u0E04\u0E38\u0E13\u0E17\u0E48\u0E32\u0E19\u0E08\u0E23\u0E34\u0E07
      \u0E46 \u0E02\u0E49\u0E32\u0E02\u0E2D\u0E15\u0E31\u0E27\u0E25\u0E32\u0E01\u0E48\u0E2D\u0E19"
    declineDialogue: "\u0E2B\u0E21\u0E2D\u0E44\u0E21\u0E48\u0E0A\u0E48\u0E27\u0E22\u0E08\u0E23\u0E34\u0E07\u0E46\u0E2B\u0E23\u0E37\u0E2D...\u0E22\u0E32\u0E22\u0E04\u0E07\u0E15\u0E49\u0E2D\u0E07\u0E1E\u0E32\u0E2B\u0E25\u0E32\u0E19\u0E01\u0E25\u0E31\u0E1A\u0E44\u0E1B\u0E17\u0E19\u0E40\u0E2D\u0E32\u0E40\u0E2D\u0E07\u0E2A\u0E34\u0E19\u0E30"
    failDialogue: "\u0E44\u0E21\u0E48\u0E40\u0E2B\u0E47\u0E19\u0E40\u0E01\u0E48\u0E07\u0E40\u0E25\u0E22\u0E19\u0E35\u0E48\u0E2B\u0E27\u0E48\u0E32...
      \u0E02\u0E49\u0E32\u0E44\u0E1B\u0E2B\u0E32\u0E2B\u0E21\u0E2D\u0E18\u0E23\u0E23\u0E21\u0E04\u0E19\u0E2D\u0E37\u0E48\u0E19\u0E14\u0E35\u0E01\u0E27\u0E48\u0E32!"
